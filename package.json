{
  "name": "talos-labs",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "desktop": "pnpm --filter @talos/desktop tauri dev",
    "desktop:build": "pnpm --filter @talos/desktop tauri build",
    "scan": "tsx scripts/scan-cli.ts",
    "sidecar:build": "pnpm --filter @talos/desktop sidecar:build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  }
}
