{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the two event permissions, window dragging and the title-strip double-click zoom, and one allow- entry per line of commands.txt. No shell, fs, http, opener, tray, menu or emit permission is granted.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-collect-system-state",
    "allow-cancel-scan",
    "allow-collect-section",
    "allow-cancel-section",
    "allow-check-capabilities",
    "allow-open-settings-pane",
    "allow-fix-preview",
    "allow-fix-apply",
    "allow-fix-preview-batch",
    "allow-fix-apply-batch",
    "allow-fix-cancel",
    "allow-fix-reveal",
    "allow-open-buy-page",
    "allow-app-restart",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-report-save-last",
    "allow-report-load-last",
    "allow-license-read",
    "allow-license-write",
    "allow-license-delete",
    "allow-ai-availability",
    "allow-ai-generate",
    "allow-ai-cancel",
    "allow-claude-generate",
    "allow-claude-cancel",
    "allow-claude-code-info",
    "allow-ai-provider-status",
    "allow-ai-connect-offered",
    "allow-ai-connect-start",
    "allow-ai-connect-poll",
    "allow-ai-connect-cancel",
    "allow-ai-disconnect",
    "allow-chatgpt-token",
    "allow-chatgpt-info",
    "allow-watch-status",
    "allow-watch-check-now",
    "allow-watch-pause",
    "allow-watch-open-main",
    "allow-watch-set-enabled",
    "allow-watch-set-interval",
    "allow-watch-set-notify",
    "allow-watch-request-notify-permission",
    "allow-watch-set-profile",
    "allow-watch-acknowledge",
    "allow-watch-answer-gate",
    "allow-watch-snooze",
    "allow-watch-context",
    "allow-watch-details",
    "allow-watch-open-source",
    "allow-watch-action-preview",
    "allow-watch-action-apply",
    "allow-autostart-enable",
    "allow-autostart-disable",
    "allow-autostart-is-enabled"
  ]
}
