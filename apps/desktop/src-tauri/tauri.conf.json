{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talos Labs",
  "version": "0.1.0",
  "identifier": "si.taloslabs.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && sh sidecar/build.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Talos Labs",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 },
        "transparent": false
      },
      {
        "label": "watch",
        "url": "watch.html",
        "width": 320,
        "height": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "transparent": false,
        "shadow": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com http://127.0.0.1:11434; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com http://127.0.0.1:11434 ws://localhost:1420 http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/talos-ai"],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "dmg": {
        "background": "assets/dmg-background.png"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
