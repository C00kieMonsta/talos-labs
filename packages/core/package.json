{
  "name": "@talos/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:emit": "tsx scripts/emit-fixtures.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
