{
  "explain": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ruleId",
      "whyItMattersForYou",
      "whatCouldHappen",
      "urgency"
    ],
    "properties": {
      "ruleId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "whyItMattersForYou": {
        "type": "string"
      },
      "whatCouldHappen": {
        "type": "string"
      },
      "urgency": {
        "type": "string",
        "enum": [
          "today",
          "this_week",
          "when_convenient"
        ]
      }
    }
  },
  "prioritise": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "order",
      "reasons",
      "startWith"
    ],
    "properties": {
      "order": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "reasons": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ruleId",
            "reason"
          ],
          "properties": {
            "ruleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "startWith": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  },
  "ask": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "answer",
      "relatedRuleIds",
      "outsideScope"
    ],
    "properties": {
      "answer": {
        "type": "string"
      },
      "relatedRuleIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "outsideScope": {
        "type": "boolean"
      }
    }
  },
  "watch": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rating",
      "ratingReason",
      "basedOn",
      "probes",
      "actions"
    ],
    "properties": {
      "rating": {
        "type": "string",
        "enum": [
          "calm",
          "keep_an_eye",
          "act_now"
        ]
      },
      "ratingReason": {
        "type": "string",
        "maxLength": 120
      },
      "basedOn": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        }
      },
      "probes": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probeId",
            "reason"
          ],
          "properties": {
            "probeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "reason": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      },
      "actions": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actionId",
            "sentence"
          ],
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "sentence": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    }
  },
  "chat": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reply",
      "relatedRuleIds",
      "outsideScope",
      "intents"
    ],
    "properties": {
      "reply": {
        "type": "string"
      },
      "relatedRuleIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "outsideScope": {
        "type": "boolean"
      },
      "intents": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ruleId",
            "signalId",
            "when"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "fix_rule",
                "fix_batch",
                "show_where",
                "explain_rule",
                "open_details",
                "show_list",
                "rescan",
                "change_ai",
                "snooze_rule",
                "accept_rule",
                "open_watch",
                "investigate",
                "close_watch",
                "remind_rule",
                "write_up",
                "what_if"
              ]
            },
            "ruleId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 32
            },
            "signalId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 48
            },
            "when": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "tomorrow",
                "sunday",
                null
              ]
            }
          }
        }
      }
    }
  }
}
