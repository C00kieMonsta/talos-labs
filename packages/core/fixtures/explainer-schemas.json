{
  "explain": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ruleId",
      "whyItMattersForYou",
      "whatCouldHappen",
      "urgency"
    ],
    "properties": {
      "ruleId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "whyItMattersForYou": {
        "type": "string"
      },
      "whatCouldHappen": {
        "type": "string"
      },
      "urgency": {
        "type": "string",
        "enum": [
          "today",
          "this_week",
          "when_convenient"
        ]
      }
    }
  },
  "prioritise": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "order",
      "reasons",
      "startWith"
    ],
    "properties": {
      "order": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "reasons": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ruleId",
            "reason"
          ],
          "properties": {
            "ruleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "startWith": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  },
  "ask": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "answer",
      "relatedRuleIds",
      "outsideScope"
    ],
    "properties": {
      "answer": {
        "type": "string"
      },
      "relatedRuleIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "outsideScope": {
        "type": "boolean"
      }
    }
  },
  "watch": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rating",
      "ratingReason",
      "basedOn",
      "probes",
      "actions"
    ],
    "properties": {
      "rating": {
        "type": "string",
        "enum": [
          "calm",
          "keep_an_eye",
          "act_now"
        ]
      },
      "ratingReason": {
        "type": "string",
        "maxLength": 300
      },
      "basedOn": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        }
      },
      "probes": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probeId",
            "reason"
          ],
          "properties": {
            "probeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "reason": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      },
      "actions": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actionId",
            "sentence"
          ],
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "sentence": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    }
  }
}
